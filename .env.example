PORT=8080
DATABASE_URL="root:@tcp(127.0.0.1:3306)/finanzas?parseTime=true&multiStatements=true&charset=utf8mb4&loc=Local"
JWT_SECRET=CMABIA_MEJOR_SECRETO_DE_PRODUCCION_MIN_32_BYTES
JWT_EXPIRATION_HOURS=72
CORS_ORIGIN=*
LOG_LEVEL=info

# MySQL (solo para docker compose; la app usa DATABASE_URL local)
MYSQL_DATABASE=finanzas
MYSQL_USER=finanzas
MYSQL_PASSWORD=CMBIALA_PASSWORD
MYSQL_ROOT_PASSWORD=CMBIALA_ROOT_PASSWORD

# Envío de mails de verificación — Brevo (producción).
# SMTP_USER = login SMTP de Brevo (Settings → SMTP & API → SMTP), NO tu email de cuenta.
# SMTP_PASS = SMTP Key (empieza con xsmtpsib-...), NO la API key (xkeysib-...).
# MAIL_FROM = dirección verificada como remitente en Brevo (Inicio → Remitentes e IP → Remitentes).
# APP_BASE_URL = URL pública de la app; el link del mail de verificación se arma con este valor.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=tu-login@smtp-brevo.com
SMTP_PASS=XSMTPSIB_TU_SMTP_KEY
MAIL_FROM=no-reply@tudominio.com
APP_BASE_URL=https://tudominio.com

# Para dev con Mailpit (captura de mails sin enviarlos), usar:
#   SMTP_HOST=localhost  (make run local) o `mailpit` (docker compose)
#   SMTP_PORT=1025
#   # sin SMTP_USER / SMTP_PASS => sin AUTH (Mailpit no pide credenciales)
#   MAIL_FROM=no-reply@optipay.local
#   APP_BASE_URL=http://localhost:8080
